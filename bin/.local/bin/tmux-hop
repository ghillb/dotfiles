#!/usr/bin/env bash
set -euo pipefail

readonly ssh_config=${SSH_CONFIG:-$HOME/.ssh/config}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf 'usage: tmux-hop HOST [SESSION]\n' >&2
  exit 2
}

shell_quote() {
  local value=$1
  printf "'%s'" "${value//\'/\'\"\'\"\'}"
}

connect_remote() {
  local host=$1
  local remote_session=$2
  local remote_command

  remote_command="exec env LC_ALL=C.UTF-8 tmux new-session -A -s $(shell_quote "$remote_session")"
  exec ssh -F "$ssh_config" -tt -- "$host" "$remote_command"
}

if [[ ${1:-} == --connect ]]; then
  [[ $# -eq 3 ]] || usage
  connect_remote "$2" "$3"
fi

[[ $# -ge 1 && $# -le 2 ]] || usage

host=$1
remote_session=${2:-}

[[ -n "$host" && "$host" != -* && "$host" != *[[:space:]]* ]] ||
  die "invalid SSH host: $host"

if [[ -z "$remote_session" ]]; then
  resolved=$(ssh -F "$ssh_config" -G "$host" 2>/dev/null) ||
    die "could not resolve SSH host: $host"
  remote_session=$(awk '$1 == "user" { print $2; exit }' <<<"$resolved")
fi

[[ "$remote_session" =~ ^[[:alnum:]_-]+$ ]] ||
  die "invalid tmux session: $remote_session"

if [[ -z ${TMUX:-} ]]; then
  connect_remote "$host" "$remote_session"
fi

local_client=${TMUX_HOP_CLIENT:-}
if [[ -z "$local_client" ]]; then
  [[ -n ${TMUX_PANE:-} ]] || die 'could not identify the current tmux pane'
  local_session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')
  mapfile -t local_clients < <(
    tmux list-clients -t "=$local_session" -F '#{client_name}'
  )
  (( ${#local_clients[@]} == 1 )) ||
    die 'could not identify one originating tmux client'
  local_client=${local_clients[0]}
fi

while IFS=$'\t' read -r session_name hop_host hop_session hop_pane; do
  if [[ "$hop_host" == "$host" && "$hop_session" == "$remote_session" ]]; then
    [[ "$hop_pane" =~ ^%[0-9]+$ ]] ||
      die "$session_name has no connection pane metadata; close it and reconnect"
    exec tmux switch-client -c "$local_client" -t "$hop_pane"
  fi
done < <(tmux list-sessions -F $'#{session_name}\t#{@hop_host}\t#{@hop_session}\t#{@hop_pane}')

origin=${TMUX_HOP_ORIGIN:-}
if [[ -z "$origin" ]]; then
  origin=$(tmux display-message -p -c "$local_client" '#{?@hop_origin,#{@hop_origin},#{session_id}}')
fi
[[ "$origin" =~ ^\$[0-9]+$ ]] && tmux has-session -t "$origin" 2>/dev/null ||
  die 'originating local workspace is unavailable; reconnect from a local workspace'

slug=${host//[^[:alnum:]_-]/-}
slug=${slug:0:40}
[[ -n "$slug" ]] || slug=remote
base_session="hop-$slug-$remote_session"
managed_session=$base_session
suffix=2
while tmux has-session -t "=$managed_session" 2>/dev/null; do
  managed_session="$base_session-$suffix"
  ((suffix += 1))
done

hop_pane=$(tmux new-session -d -P -F '#{pane_id}' -s "$managed_session" -n ssh 'sleep 86400')
tmux set-option -t "$managed_session" @hop_host "$host"
tmux set-option -t "$managed_session" @hop_session "$remote_session"
tmux set-option -t "$managed_session" @hop_origin "$origin"
tmux set-option -t "$managed_session" @hop_pane "$hop_pane"
tmux set-option -t "$managed_session" status off
tmux set-option -t "$managed_session" prefix None
tmux set-option -t "$managed_session" prefix2 None
tmux set-option -t "$managed_session" key-table hop
tmux set-option -t "$managed_session" mouse off
tmux set-option -t "$managed_session" detach-on-destroy off

self=${BASH_SOURCE[0]}
connect_command="exec env SSH_CONFIG=$(shell_quote "$ssh_config")"
connect_command+=" $(shell_quote "$self") --connect"
connect_command+=" $(shell_quote "$host")"
connect_command+=" $(shell_quote "$remote_session")"

tmux switch-client -c "$local_client" -t "$hop_pane"
tmux respawn-pane -k -t "$hop_pane" "$connect_command"

#!/usr/bin/env bash
set -euo pipefail

auth_profiles_dir="${HOME}/.codex-auth-profiles"
current_file="${auth_profiles_dir}/.current"
shared_home="${HOME}/.codex"
shared_auth="${shared_home}/auth.json"

usage() {
  cat <<'EOF'
Usage: cx-switch <command> [arguments]

Commands:
  clear          Clear the active profile
  delete <name>  Delete a saved profile
  save <name>    Save current authentication as a profile
  use <name>     Activate a saved profile
  current        Print the active profile name
  list           List saved profiles
  status         Show active profile details
  limits [<name>|--all]
                 Show usage limits for one or all profiles
  help           Show this help
EOF
}

validate_profile_name() {
  local name="$1"
  case "$name" in
    *[!A-Za-z0-9._@-]*)
      echo "cx-switch: invalid profile name: $name" >&2
      exit 1
      ;;
  esac
}

require_no_codex_processes() {
  if ! command -v pgrep >/dev/null 2>&1; then
    echo "cx-switch: pgrep is required to verify that Codex is stopped" >&2
    exit 1
  fi
  if pgrep -x codex >/dev/null 2>&1 || pgrep -x codex-cli >/dev/null 2>&1; then
    echo "cx-switch: Codex is running; exit all Codex sessions first" >&2
    exit 1
  fi
}

auth_email() {
  local path="$1"

  jq -er '
    .tokens.id_token
    | split(".")[1]
    | gsub("-"; "+")
    | gsub("_"; "/")
    | @base64d
    | fromjson
    | .email
  ' "$path" 2>/dev/null
}

require_auth_matches_profile() {
  local name="$1"
  local path="$2"
  local email

  case "$name" in
    *@*)
      if ! email="$(auth_email "$path")"; then
        echo "cx-switch: cannot verify account identity in $path" >&2
        exit 1
      fi
      if [ "${email,,}" != "${name,,}" ]; then
        echo "cx-switch: profile $name contains authentication for $email" >&2
        exit 1
      fi
      ;;
  esac
}

get_current_profile() {
  if [ -f "$current_file" ]; then
    tr -d '[:space:]' < "$current_file"
    printf '\n'
  else
    echo "unset"
  fi
}

copy_auth() {
  local source="$1"
  local destination="$2"
  local destination_dir temporary_auth

  destination_dir="$(dirname "$destination")"
  mkdir -p "$destination_dir"
  temporary_auth="$(mktemp "${destination_dir}/.cx-switch-auth.XXXXXX")"
  if ! cp -- "$source" "$temporary_auth" ||
    ! chmod 600 "$temporary_auth" ||
    ! mv -f -- "$temporary_auth" "$destination"; then
    rm -f -- "$temporary_auth"
    return 1
  fi
}

persist_current_profile() {
  local name profile_auth current_email saved_email

  if [ ! -f "$current_file" ] || [ ! -f "$shared_auth" ]; then
    return
  fi
  name="$(get_current_profile)"
  if [ "$name" = "unset" ] || [ -z "$name" ]; then
    return
  fi
  validate_profile_name "$name"
  profile_auth="${auth_profiles_dir}/${name}.json"
  require_auth_matches_profile "$name" "$shared_auth"
  if [ -f "$profile_auth" ]; then
    if current_email="$(auth_email "$shared_auth")" && saved_email="$(auth_email "$profile_auth")" &&
      [ "$current_email" != "$saved_email" ]; then
      echo "cx-switch: active authentication does not match profile $name" >&2
      exit 1
    fi
  fi
  copy_auth "$shared_auth" "$profile_auth"
}

format_reset_at() {
  local epoch="$1"
  local reset_day today
  if [ -z "$epoch" ]; then
    echo "unknown"
    return
  fi

  reset_day="$(date -d "@$epoch" +%F)"
  today="$(date +%F)"
  if [ "$reset_day" = "$today" ]; then
    date -d "@$epoch" +%H:%M
  else
    date -d "@$epoch" +"%H:%M on %-d %b"
  fi
}

window_label() {
  local minutes="$1"
  local fallback="$2"
  case "$minutes" in
    300) echo "5h limit" ;;
    10080) echo "Weekly limit" ;;
    "") echo "$fallback" ;;
    *) echo "${minutes}m limit" ;;
  esac
}

fetch_limits_json() {
  local name="$1"
  local profile_auth="${auth_profiles_dir}/${name}.json"
  local tmp_home temporary_auth source_auth current_profile result line maybe

  if [ ! -f "$profile_auth" ]; then
    echo "cx-switch: no auth stored yet for profile $name" >&2
    exit 1
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo "cx-switch: jq is required for limits" >&2
    exit 1
  fi
  if ! command -v codex >/dev/null 2>&1; then
    echo "cx-switch: codex is required for limits" >&2
    exit 1
  fi

  tmp_home="$(mktemp -d "${auth_profiles_dir}/.cx-switch-home.XXXXXX")"
  temporary_auth="${tmp_home}/.codex/auth.json"
  source_auth="$profile_auth"
  current_profile="$(get_current_profile)"
  if [ "$current_profile" = "$name" ] && [ -f "$shared_auth" ]; then
    source_auth="$shared_auth"
  fi
  require_auth_matches_profile "$name" "$source_auth"
  copy_auth "$source_auth" "$temporary_auth"

  cleanup_limits() {
    if [ -n "${APP_PID:-}" ]; then
      kill "$APP_PID" 2>/dev/null || true
      wait "$APP_PID" 2>/dev/null || true
      unset APP_PID
    fi
    if [ -f "$temporary_auth" ]; then
      copy_auth "$temporary_auth" "$profile_auth"
      if [ "$current_profile" = "$name" ]; then
        copy_auth "$temporary_auth" "$shared_auth"
      fi
    fi
    rm -rf "$tmp_home"
  }

  trap cleanup_limits RETURN

  result=""
  coproc APP { HOME="$tmp_home" codex app-server 2>/dev/null; }

  printf '%s\n' '{"method":"initialize","id":1,"params":{"clientInfo":{"name":"cx-switch","title":"cx-switch","version":"1"},"capabilities":{"experimentalApi":true}}}' >&"${APP[1]}"
  while IFS= read -r -t 5 line <&"${APP[0]}"; do
    if printf '%s\n' "$line" | jq -e '.id == 1' >/dev/null 2>&1; then
      break
    fi
  done

  printf '%s\n' '{"method":"initialized"}' >&"${APP[1]}"
  printf '%s\n' '{"method":"account/rateLimits/read","id":2,"params":null}' >&"${APP[1]}"
  while IFS= read -r -t 10 line <&"${APP[0]}"; do
    maybe="$(printf '%s\n' "$line" | jq -c 'select(.id == 2) | .result' 2>/dev/null || true)"
    if [ -n "$maybe" ]; then
      result="$maybe"
      break
    fi
  done

  cleanup_limits
  trap - RETURN

  if [ -z "$result" ]; then
    echo "cx-switch: failed to read limits for profile $name" >&2
    return 1
  fi
  printf '%s\n' "$result"
}

save_profile() {
  local name="$1"
  local profile_auth="${auth_profiles_dir}/${name}.json"
  local tmp_auth

  if [ ! -e "$shared_auth" ]; then
    echo "cx-switch: no active auth to save" >&2
    echo "run: cx login" >&2
    exit 1
  fi

  mkdir -p "$auth_profiles_dir" "$shared_home"
  require_auth_matches_profile "$name" "$shared_auth"

  tmp_auth="$(mktemp "${auth_profiles_dir}/.${name}.XXXXXX")"
  cleanup_save() {
    rm -f "$tmp_auth"
  }
  trap cleanup_save RETURN

  cp "$shared_auth" "$tmp_auth"
  chmod 600 "$tmp_auth"
  mv -f "$tmp_auth" "$profile_auth"

  echo "saved profile: $name"
  echo "auth: $profile_auth"
}

clear_profile() {
  persist_current_profile
  rm -f "$shared_auth" "$current_file"
  echo "cleared active profile"
  echo "auth: ${shared_home}/auth.json"
}

delete_profile() {
  local name="$1"
  local profile_auth="${auth_profiles_dir}/${name}.json"
  local current_profile

  if [ ! -f "$profile_auth" ]; then
    echo "cx-switch: no saved auth for profile $name" >&2
    exit 1
  fi

  if [ -f "$current_file" ]; then
    current_profile="$(tr -d '[:space:]' < "$current_file")"
  else
    current_profile="unset"
  fi

  rm -f "$profile_auth"

  if [ "$current_profile" = "$name" ]; then
    rm -f "$current_file" "$shared_auth"
    echo "deleted profile: $name"
    echo "cleared active profile"
    echo "auth: ${shared_home}/auth.json"
  else
    echo "deleted profile: $name"
    echo "auth: $profile_auth"
  fi
}

print_limits() {
  local name="$1"
  local payload snapshot plan credits_has credits_unlimited credits_balance
  local primary_used primary_mins primary_reset secondary_used secondary_mins secondary_reset
  local left label

  payload="$(fetch_limits_json "$name")"
  snapshot="$(printf '%s\n' "$payload" | jq -c '.rateLimitsByLimitId.codex // .rateLimits')"

  plan="$(printf '%s\n' "$snapshot" | jq -r '.planType // "unknown"')"
  credits_has="$(printf '%s\n' "$snapshot" | jq -r '.credits.hasCredits // false')"
  credits_unlimited="$(printf '%s\n' "$snapshot" | jq -r '.credits.unlimited // false')"
  credits_balance="$(printf '%s\n' "$snapshot" | jq -r '.credits.balance // empty')"

  echo "profile: $name"
  echo "plan: $plan"

  primary_used="$(printf '%s\n' "$snapshot" | jq -r '.primary.usedPercent // empty')"
  primary_mins="$(printf '%s\n' "$snapshot" | jq -r '.primary.windowDurationMins // empty')"
  primary_reset="$(printf '%s\n' "$snapshot" | jq -r '.primary.resetsAt // empty')"
  if [ -n "$primary_used" ]; then
    left=$((100 - primary_used))
    label="$(window_label "$primary_mins" "Primary limit")"
    echo "$label: ${left}% left (resets $(format_reset_at "$primary_reset"))"
  fi

  secondary_used="$(printf '%s\n' "$snapshot" | jq -r '.secondary.usedPercent // empty')"
  secondary_mins="$(printf '%s\n' "$snapshot" | jq -r '.secondary.windowDurationMins // empty')"
  secondary_reset="$(printf '%s\n' "$snapshot" | jq -r '.secondary.resetsAt // empty')"
  if [ -n "$secondary_used" ]; then
    left=$((100 - secondary_used))
    label="$(window_label "$secondary_mins" "Secondary limit")"
    echo "$label: ${left}% left (resets $(format_reset_at "$secondary_reset"))"
  fi

  if [ "$credits_unlimited" = "true" ]; then
    echo "credits: unlimited"
  elif [ "$credits_has" = "true" ] && [ -n "$credits_balance" ]; then
    echo "credits: $credits_balance"
  else
    echo "credits: none"
  fi
}

print_all_limits() {
  local path name
  local found=0

  for path in "$auth_profiles_dir"/*.json; do
    if [ ! -f "$path" ]; then
      continue
    fi
    if [ "$found" -eq 1 ]; then
      printf '\n'
    fi
    found=1
    name="$(basename "$path" .json)"
    print_limits "$name"
  done

  if [ "$found" -eq 0 ]; then
    echo "no profiles"
  fi
}

cmd="${1:-status}"

case "$cmd" in
  help | -h | --help)
    usage
    ;;
  clear)
    require_no_codex_processes
    clear_profile
    ;;
  delete)
    require_no_codex_processes
    name="${2:-}"
    if [ -z "$name" ]; then
      usage >&2
      exit 1
    fi
    validate_profile_name "$name"
    delete_profile "$name"
    ;;
  save)
    require_no_codex_processes
    name="${2:-}"
    if [ -z "$name" ]; then
      usage >&2
      exit 1
    fi
    validate_profile_name "$name"
    save_profile "$name"
    ;;
  use)
    require_no_codex_processes
    name="${2:-}"
    if [ -z "$name" ]; then
      usage >&2
      exit 1
    fi
    validate_profile_name "$name"
    mkdir -p "$auth_profiles_dir" "$shared_home"
    profile_auth="${auth_profiles_dir}/${name}.json"
    if [ ! -e "$profile_auth" ]; then
      echo "cx-switch: no saved auth for profile $name" >&2
      echo "run: cx login, then cx-switch save $name" >&2
      exit 1
    fi
    require_auth_matches_profile "$name" "$profile_auth"
    persist_current_profile
    copy_auth "$profile_auth" "$shared_auth"
    printf '%s\n' "$name" > "$current_file"
    echo "active profile: $name"
    echo "auth: $profile_auth"
    ;;
  current)
    get_current_profile
    ;;
  list)
    mkdir -p "$auth_profiles_dir"
    current=""
    if [ -f "$current_file" ]; then
      current="$(tr -d '[:space:]' < "$current_file")"
    fi
    found=0
    for path in "$auth_profiles_dir"/*.json; do
      if [ ! -f "$path" ]; then
        continue
      fi
      found=1
      name="$(basename "$path" .json)"
      if [ "$name" = "$current" ]; then
        echo "* $name"
      else
        echo "  $name"
      fi
    done
    if [ "$found" -eq 0 ]; then
      echo "no profiles"
    fi
    ;;
  status)
    if [ -f "$current_file" ]; then
      name="$(tr -d '[:space:]' < "$current_file")"
      echo "mode: auth-profile"
      echo "profile: ${name:-unset}"
      echo "auth: ${auth_profiles_dir}/${name}.json"
      echo "state: ${shared_home}"
    else
      echo "mode: unset"
      echo "profile: unset"
      echo "auth: unset"
      echo "state: ${shared_home}"
    fi
    ;;
  limits)
    require_no_codex_processes
    name="${2:-}"
    if [ "$name" = "--all" ]; then
      print_all_limits
    elif [ -z "$name" ]; then
      name="$(get_current_profile)"
      if [ "$name" = "unset" ]; then
        echo "cx-switch: no active profile" >&2
        exit 1
      fi
      print_limits "$name"
    else
      validate_profile_name "$name"
      print_limits "$name"
    fi
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
